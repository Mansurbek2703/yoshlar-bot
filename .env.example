# Telegram Bot Configuration
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Database (PostgreSQL + asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/youth_bot

# Administrator Telegram IDs (comma-separated)
ADMIN_IDS=123456789,987654321

# Webhook & Server Settings
# Set USE_WEBHOOK=False for local polling development, True for production with domain
USE_WEBHOOK=False
WEBHOOK_HOST=https://yoshlar.akhu.uz
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=super_secret_webhook_token_replace_me
WEB_SERVER_HOST=0.0.0.0
WEB_SERVER_PORT=8000

# File limits (in bytes: 50MB = 52428800)
MAX_FILE_SIZE=52428800

# System Settings
TIMEZONE=Asia/Tashkent
LOG_LEVEL=INFO
